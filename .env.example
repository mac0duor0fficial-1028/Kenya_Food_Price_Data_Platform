# ---------------------------------------------------------------
# ken-rtfp environment file
# Copy to .env and edit:   cp .env.example .env
# .env is git-ignored. Never commit real credentials.
# -----------------------------------------------------------------

# --- PostgreSQL container (read by docker-compose.yml) -----------
# Change the password for anything other than a local laptop.

PG_USER=rtfp
PG_PASSWORD=rtfp
PG_DB=rtfp

# --- Pipeline connection (read by src/ken_rtfp/config.py) --------
# Format: postgresql+psycopg2://<PG_USER>:<PG_PASSWORD>@<host>:<port>/<PG_DB>
# Host port 5433 is the left side of "5433:5432" in docker-compose.yml.
# Must use the psycopg2 driver (Airflow 2.10 pins SQLAlchemy 1.4).
# If you change PG_USER / PG_PASSWORD / PG_DB above, change them here too.
# Special characters in the password must be URL-encoded (e.g. @ -> %40).
PG_DSN=postgresql+psycopg2://rtfp:rtfp@localhost:5433/rtfp

# --- Airflow (optional) -------------------------------------------
# Airflow does NOT read this file by itself. Load it into your shell
# from the repo root before running airflow:
#     set -a; source .env; set +a
# ${PWD} is expanded by the shell, so Airflow gets absolute paths.

AIRFLOW_HOME=${PWD}/.airflow
AIRFLOW__CORE__DAGS_FOLDER=${PWD}/dags
AIRFLOW__CORE__LOAD_EXAMPLES=False
